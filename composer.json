{
    "name": "ak-flash/laravel-max-logger",
    "description": "Laravel logging channel for MAX with deduplication and rate limiting",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/cache": "^12.0",
        "illuminate/config": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/log": "^12.0",
        "illuminate/support": "^12.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AkFlash\\MaxLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AkFlash\\MaxLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["AkFlash\\MaxLogger\\MaxLoggerServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    }
}
